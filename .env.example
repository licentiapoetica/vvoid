# vvoid's settings, all of them: copy to .env and uncomment what you change (or set them in the panel, npm run panel).
# Each is shown with its default where it has one; left commented out, the default holds.
# vvoid reads .env once, as it starts: restart it for a change to count.

# ---- vvoid ----

# Claude's key (read by the Anthropic SDK); without one the void is made of local noise instead of dreams
#ANTHROPIC_API_KEY=

# a password at every plugin's ring (VVOID_<NAME>_PASSWORD, over it, for one; see locks.js)
#VVOID_PASSWORD=

# how long a right password is remembered: 30d, 12h, 10m (unset: asked every time)
#VVOID_REMEMBER=

#PORT=5173

# bind address
#VVOID_HOST=127.0.0.1

# who dreams
#VVOID_MODEL=claude-opus-5-5

# higher: slower, more considered places
#VVOID_EFFORT=low

# 1: Opus fast mode (twice the price)
# (default: off)
#VVOID_FAST=

# where the dreamt places are kept
#VVOID_CACHE=.cache/sectors

# new places per run of the server
#VVOID_MAX_SECTORS=300

# turns of the entity per run
#VVOID_MAX_BEATS=600

# how many may be in the void at once; the rest wait in line on the start screen
# (default: none)
#VVOID_MAX_SLOTS=

# open vvoid once as /?admin=<key>: that browser is admin for a year, straight in past the line (taking no
# slot) and through every portal without its password; /?admin= lets it go
# (default: none)
#VVOID_ADMIN_KEY=

# where the void's look is kept (as an admin turns it: Tab, then look)
#VVOID_LOOK=.cache/look.json

# what each portal is, in your words, on a pane inside it, beside its way back; and each one's quick access, a
# word of its own: /<word> on vvoid's address starts you before that portal and flies you in (both written
# from the panel's plugins page; seen without a restart)
#VVOID_PORTALS=.cache/portals.json

# plugins left in plugins/ but not loaded: their folders' names, split by commas
# (default: none)
#VVOID_PLUGINS_OFF=

# ---- this panel ----
# read as the panel starts: restart it (npm run panel) for a change to count

# the panel's port
#VVOID_PANEL_PORT=5174

# its bind address (anything wider: put it behind https, as it shows every key)
#VVOID_PANEL_HOST=127.0.0.1

# the key that makes the first passkey, while there is none (and nothing else)
# (default: a new one each run)
#VVOID_PANEL_KEY=

# the panel's addresses as the browser shows them, besides http://localhost:<port> (always one), split by
# commas (https://panel.example.org behind a proxy): a passkey is made for one of them, and taken there only
# (default: none)
#VVOID_PANEL_ORIGIN=

# where its passkeys are kept (delete it, and the key makes one again)
#VVOID_PANEL_PASSKEYS=.cache/panel-passkeys.json

# 1: start vvoid as the panel starts
# (default: off)
#VVOID_PANEL_START=

# the systemd unit vvoid runs as (vvoid, vvoid.service): the panel's start, stop and restart are that unit's
# (systemctl), its state is shown, and its journal is the log; the panel starts no vvoid of its own then. A
# system unit, as the panel's user: through polkit, else sudo -n (a sudoers line such as kibi ALL=(root)
# NOPASSWD: /usr/bin/systemctl restart vvoid.service, one for each of start, stop and restart wanted); its
# journal, the panel's user in systemd-journal
# (default: none)
#VVOID_PANEL_SYSTEMD=

# 1: that unit is one of the panel's user's own (systemctl --user)
# (default: off)
#VVOID_PANEL_SYSTEMD_USER=

# ---- bhop ----

#VVOID_BHOP_CSS=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_BHOP_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_BHOP_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_BHOP_REMEMBER=

# ---- chan ----

#VVOID_CHAN_BOARDS=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_CHAN_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_CHAN_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_CHAN_REMEMBER=

# ---- discord ----

#VVOID_DISCORD_API=

# where it keeps what it keeps (default .cache/discord): the sessions (by their hash), each bot's presence and
# the direct messages it has had, and Discord's pictures.
#VVOID_DISCORD_CACHE=

# log only problems. Otherwise every request to Discord is logged as it is answered ([vvoid] discord: <bot> →
# GET /channels/… · 200 · 85ms).
#VVOID_DISCORD_DEBUG=

# the password (vvoid's lock, as any plugin can have one: see "Locks" in WRITING-PLUGINS.md; vvoid's own
# VVOID_PASSWORD does as well, if this is not set). Unlike the others, discord needs one: without it (or
# without a token) the ring says "not set up" and opens to no one.
#VVOID_DISCORD_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_DISCORD_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_DISCORD_REMEMBER=

# one or more bots' tokens, split by commas. Each bot is its own account in the client: its picture at the top
# of the rail holds its direct messages, its servers under it.
#VVOID_DISCORD_TOKEN=

# ---- edge ----

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_EDGE_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_EDGE_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_EDGE_REMEMBER=

# ---- efukt ----

# where your searches are kept (default .cache/efukt/ in vvoid)
#VVOID_EFUKT_CACHE=

# the categories with a ring round the way in, named as in eFukt's links, comma separated, up to 24 (default
# lulz,wtf,fail,bizarre,crazy,public,amateur,documentary,fights,vintage; it has forty, listed on
# efukt.com/categories/)
#VVOID_EFUKT_CATEGORIES=

# log only rests and errors, not every request
#VVOID_EFUKT_DEBUG=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_EFUKT_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_EFUKT_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_EFUKT_REMEMBER=

# ---- f0ck ----

# the instance, e.g. http://localhost:1337
# (default: unset)
#VVOID_F0CK=

#VVOID_F0CK_FILES=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_F0CK_PASSWORD=

# pass the instance through on this port instead of on vvoid's own address
# (default: unset)
#VVOID_F0CK_PORT=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_F0CK_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_F0CK_REMEMBER=

# open posts on the instance at this address instead of through vvoid
# (default: unset)
#VVOID_F0CK_SITE=

# ---- files ----

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_FILES_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_FILES_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_FILES_REMEMBER=

# ---- gumo ----

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_GUMO_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_GUMO_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_GUMO_REMEMBER=

# ---- mania ----

# 0: no searching beatconnect.io from the window
# (default: on)
#VVOID_MANIA_BEATCONNECT=

# the index, imports and scores
#VVOID_MANIA_CACHE=.cache/mania

#VVOID_MANIA_DEBUG=

# 0: nothing can be dropped in from the page
# (default: on)
#VVOID_MANIA_IMPORT=

# MB, at most, in one import (or one set from beatconnect)
#VVOID_MANIA_IMPORT_MAX=300

#VVOID_MANIA_IMPORT_QUOTA=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_MANIA_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_MANIA_PORTAL=

# Quaver's folder or its Songs folder; 0: not read (its skins neither)
# (default: found)
#VVOID_MANIA_QUAVER=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_MANIA_REMEMBER=

# folders of Quaver skins, a folder a skin (: between them)
#VVOID_MANIA_SKINS=plugins/mania/skins

# folders of songs (: between them)
#VVOID_MANIA_SONGS=plugins/mania/songs

# ---- marderchen ----

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_MARDERCHEN_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_MARDERCHEN_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_MARDERCHEN_REMEMBER=

#VVOID_URL=

# ---- player ----

# where what each file says is kept (default .cache/player/), with its size and time, so a second reading
# reads only what is new or changed; covers found inside files are kept there too, one for each picture.
#VVOID_PLAYER_CACHE=

#VVOID_PLAYER_CONVERT_MAX=

# the folders your music is in, kept apart by : (~/Music:/mnt/music/flac). Read through when the library is
# first asked for, and again (in the background) when it is half an hour old, or at read again in the panel.
# Anyone who can reach vvoid's address can play what is in them: with VVOID_HOST other than 127.0.0.1, that is
# more than you.
#VVOID_PLAYER_MUSIC=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_PLAYER_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_PLAYER_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_PLAYER_REMEMBER=

# ---- pt ----

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_PT_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_PT_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_PT_REMEMBER=

# ---- redgifs ----

# where your ways in are kept (default .cache/redgifs/ in vvoid)
#VVOID_REDGIFS_CACHE=

#VVOID_REDGIFS_DEBUG=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_REDGIFS_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_REDGIFS_PORTAL=

# a SOCKS5 proxy for RedGIFs' API, e.g. 127.0.0.1:9050 (Tor). Only the API goes through it (by curl); the
# videos and posters still come straight from RedGIFs' media host. The pacing and the rests hold through it as
# without; with the proxy not there, it waits half a minute between tries and says so once.
#VVOID_REDGIFS_PROXY=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_REDGIFS_REMEMBER=

# ---- saber ----

#VVOID_PROBE=

#VVOID_REGRESS=

# who may add avatars: admin, all, 0
# (default: all)
#VVOID_SABER_ADD_AVATARS=

# who may add maps (imported, fetched from BeatSaver, a playlist's fetched): admin, all, 0 (no one); one
# already here is still had by anyone
# (default: all)
#VVOID_SABER_ADD_MAPS=

# who may add notes (.bloq): admin, all, 0
# (default: all)
#VVOID_SABER_ADD_NOTES=

# who may add platforms (.plat): admin, all, 0
# (default: all)
#VVOID_SABER_ADD_PLATFORMS=

# who may add sabers (dropped in, or from ModelSaber): admin, all, 0
# (default: all)
#VVOID_SABER_ADD_SABERS=

# 0: no BeatLeader
# (default: on)
#VVOID_SABER_BEATLEADER=

# Beat Saber's folder or its CustomLevels; 0: not read
# (default: found)
#VVOID_SABER_BEATSABER=

# 0: no BeatSaver
# (default: on)
#VVOID_SABER_BEATSAVER=

# imports, covers, previews, replays, the index and scores
#VVOID_SABER_CACHE=.cache/saber

# 0: only rests and errors are logged
# (default: on)
#VVOID_SABER_DEBUG=

# who may delete maps: admin, all, 0 (no one)
# (default: admin with an admin key, else all)
#VVOID_SABER_DELETE=

# 0: nothing can be dropped in or fetched
# (default: on)
#VVOID_SABER_IMPORT=

# MB, at most, in one map
#VVOID_SABER_IMPORT_MAX=200

# folders of maps (: between them)
#VVOID_SABER_MAPS=plugins/saber/maps

# 0: no ModelSaber (models dropped on the window still work)
# (default: on)
#VVOID_SABER_MODELSABER=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_SABER_PASSWORD=

# who may change the favourites and playlists: admin, all, 0 (no one)
# (default: admin with an admin key, else all)
#VVOID_SABER_PLAYLISTS=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_SABER_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_SABER_REMEMBER=

# 0: no song's video behind the track
# (default: on)
#VVOID_SABER_VIDEOS=

# MB of videos kept, the least lately played let go first
#VVOID_SABER_VIDEOS_MAX=4096

# where a map's Vivify bundles are fetched from when its download has none (by Info.dat's checksums, as the
# mod does: https://repo.totalbs.dev/api/v1/bundles/); 0: never
# (default: Vivify's own)
#VVOID_SABER_VIVIFY_REPO=

# where yt-dlp is
#VVOID_SABER_YTDLP=yt-dlp

# more for yt-dlp, its own arguments (--cookies-from-browser firefox, say)
# (default: none)
#VVOID_SABER_YTDLP_ARGS=

# ---- shorts ----

# where the browser's profile and your ways in are kept (default .cache/shorts/)
#VVOID_SHORTS_CACHE=

# where Chromium is (default: VVOID_TIKTOK_CHROME, else /usr/bin/chromium)
#VVOID_SHORTS_CHROME=

# log only rests and errors, not every request
#VVOID_SHORTS_DEBUG=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_SHORTS_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_SHORTS_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_SHORTS_REMEMBER=

# ---- somafm ----

# log only problems. Otherwise every request to SomaFM is logged as it is answered ([vvoid] somafm: → … ·
# status · ms), and every stream passed on as it closes.
#VVOID_SOMAFM_DEBUG=

# the page plays the streams straight from SomaFM, not passed on by the server (silent on localhost; ignored
# with a proxy).
#VVOID_SOMAFM_DIRECT=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_SOMAFM_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_SOMAFM_PORTAL=

# a SOCKS5 proxy (127.0.0.1:9050, or socks5h://…) SomaFM is asked through, by curl: the list, the playlists
# and the streams.
#VVOID_SOMAFM_PROXY=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_SOMAFM_REMEMBER=

# ---- tiktok ----

# where the videos and the browser's guest profile are kept (default .cache/tiktok/ in vvoid)
#VVOID_TIKTOK_CACHE=

# where Chromium is (default /usr/bin/chromium)
#VVOID_TIKTOK_CHROME=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_TIKTOK_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_TIKTOK_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_TIKTOK_REMEMBER=

# ---- together ----

# travellers at once; further pages are turned away
#VVOID_TOGETHER_MAX=64

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_TOGETHER_PASSWORD=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_TOGETHER_REMEMBER=

# ---- watch ----

# how many pages may be connected at once (64).
#VVOID_WATCH_MAX=

# a password at its ring (vvoid's lock; see "Locks" in WRITING-PLUGINS.md). Anyone who reaches vvoid can
# otherwise watch what is shared.
#VVOID_WATCH_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_WATCH_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_WATCH_REMEMBER=

# how many screens may be shared at once (8).
#VVOID_WATCH_SHARES=

# ---- z0r ----

# where the index, the loops and your searches are kept (default .cache/z0r/)
#VVOID_Z0R_CACHE=

# log only rests and errors, not every request
#VVOID_Z0R_DEBUG=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_Z0R_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_Z0R_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_Z0R_REMEMBER=

# ---- zone ----

#VVOID_ZONE=

# a password at its ring (empty: open, whatever VVOID_PASSWORD says)
#VVOID_ZONE_PASSWORD=

# where its portal stands: angle,distance,height (degrees round the clock, 0 ahead as you arrive, 90 to the
# right; unset: in its place on the circle)
# (default: auto)
#VVOID_ZONE_PORTAL=

# how long its password is remembered: 30d, 12h (over VVOID_REMEMBER)
#VVOID_ZONE_REMEMBER=
